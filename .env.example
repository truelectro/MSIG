# Ride Your Flame Environment Variables

# Demo Mode Configuration
# When set to 'true', checkout processes simulated idempotent transactions
# without connecting to live payment rails or charging real cards.
NEXT_PUBLIC_DEMO_MODE=true

# Production Payment Rail Keys (Leave empty for demo simulation)
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Organizer notification email service (optional in demo mode)
# RESEND_API_KEY=
